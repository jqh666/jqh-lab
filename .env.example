# JQH Lab environment template
# Copy this file to .env and fill in real values before deployment.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jqh_lab
DB_USERNAME=jqh
DB_PASSWORD=change_me

# Redis
REDIS_URL=redis://localhost:6379/0

# Qwen API
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode

# JWT
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# Admin account
ADMIN_USERNAME=jqh
ADMIN_PASSWORD=change_me
